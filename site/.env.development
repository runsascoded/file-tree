# `pnpm dev` defaults to the deployed worker so `/http` works without
# spinning up the local CFW. To develop the worker, set
# `VITE_HTTP_DEMO_BASE=http://localhost:8732/v1/files` in `.env.local`
# (gitignored) and run `pnpm --dir site/worker dev`.
VITE_HTTP_DEMO_BASE=https://file-tree-demo.ryan-0dc.workers.dev/v1/files
